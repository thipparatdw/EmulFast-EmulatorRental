# ==========================================
# EmulFast — Windows Local Dev Environment
# ==========================================
# คัดลอกเป็น .env.dev แล้วแทนที่ XXXXX ด้วยค่าจริงจาก .env ของคุณ
# ใช้กับ: docker compose --env-file .env.dev ...
# ห้าม commit .env.dev เข้า git

# ---- General ----
NODE_ENV=development
TZ=Asia/Bangkok

# ---- External AI helpers (CLI) ----
DEEPSEEK_API_KEY=XXXXX
OPENAI_API_KEY=XXXXX
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- apps/api (NestJS) ----
API_PORT=4000
DATABASE_URL=postgresql://emulfast:postgres@localhost:5432/emulfast
REDIS_URL=redis://localhost:6379

JWT_SECRET=XXXXX
JWT_REFRESH_SECRET=XXXXX
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Payment gateways (test keys — คัดลอกจาก .env)
STRIPE_SECRET_KEY=sk_test_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX
OMISE_PUBLIC_KEY=pkey_test_XXXXX
OMISE_SECRET_KEY=skey_test_XXXXX
OMISE_WEBHOOK_SECRET=XXXXX

# Orchestrator (internal)
ORCHESTRATOR_URL=http://localhost:5000
ORCHESTRATOR_TOKEN=XXXXX

# CORS — Windows dev ใช้ localhost
CORS_ORIGIN=http://localhost:3000

# ---- apps/web (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SCRCPY_WS_URL=ws://localhost:8000

# ---- apps/orchestrator ----
ORCHESTRATOR_PORT=5000
# Windows Docker Desktop — named pipe (จำเป็นบน Windows)
DOCKER_HOST=npipe:////./pipe/docker_engine
# DEV_MOCK=true → ข้ามการสร้าง Redroid container จริง (Windows ไม่มี /dev/binder)
DEV_MOCK=true
REDROID_NETWORK=emulfast-redroid
ADB_PORT_RANGE_START=5555
ADB_PORT_RANGE_END=5655
# ws-scrcpy รันบน localhost (ไม่ใช่ container name)
WS_SCRCPY_BASE_URL=http://localhost:8000

# ---- Postgres (docker compose) ----
POSTGRES_DB=emulfast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./infra/docker/data/uploads
