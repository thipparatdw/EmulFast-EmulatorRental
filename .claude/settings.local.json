{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NODE_ENV": "development",
    "TZ": "Asia/Bangkok"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm dlx shadcn@latest add:*)",
      "Bash(pnpm prisma:*)",
      "Bash(pnpm exec prisma:*)",
      "Bash(npx prisma:*)",
      "Bash(docker compose config)",
      "Bash(docker compose -f infra/compose/docker-compose.yml config)",
      "Bash(docker compose -f infra/compose/docker-compose.yml build:*)",
      "Bash(docker compose -f infra/compose/docker-compose.yml up:*)",
      "Bash(docker compose -f infra/compose/docker-compose.yml ps)",
      "Bash(docker compose -f infra/compose/docker-compose.yml logs:*)",
      "Bash(docker compose -f infra/compose/docker-compose.yml down:*)",
      "Bash(docker --version)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(nginx -t:*)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(chmod +x scripts/*.sh)",
      "Bash(bash ./scripts/deepseek-research.sh:*)",
      "Bash(bash ./scripts/gpt-debug.sh:*)",
      "Read(//**)",
      "Write(./apps/**)",
      "Write(./packages/**)",
      "Write(./infra/**)",
      "Write(./docs/**)",
      "Write(./.claude/**)",
      "Write(./.github/**)",
      "Write(./CLAUDE.md)",
      "Write(./AGENTS.md)",
      "Write(./README.md)",
      "Write(./*.json)",
      "Write(./*.yaml)",
      "Write(./*.yml)",
      "Write(./.env.example)",
      "Write(./.gitignore)",
      "Write(./turbo.json)",
      "Write(./pnpm-workspace.yaml)",
      "Edit(./apps/**)",
      "Edit(./packages/**)",
      "Edit(./infra/**)",
      "Edit(./docs/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Edit(./README.md)",
      "Bash(docker compose *)",
      "Bash(pnpm list *)",
      "Bash(xargs ls *)",
      "Bash(tee /tmp/web_lint.log)",
      "Bash(tee /tmp/web_typecheck.log)",
      "Bash(tee /tmp/web_build.log)",
      "Bash(tee /tmp/shared_typecheck.log)",
      "Bash(tee /tmp/shared_build.log)",
      "Bash(chmod +x /home/emf01/emulfast-project/scripts/smoke-test.sh)",
      "Bash(bash -n /home/emf01/emulfast-project/scripts/smoke-test.sh)",
      "Bash(DATABASE_URL=\"postgresql://placeholder:placeholder@localhost:5432/emulfast\" pnpm *)",
      "Bash(pnpm ls *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker rm -f:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm install -g:*)",
      "Bash(pnpm add -g:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)"
    ],
    "ask": [
      "Bash(docker compose -f infra/compose/docker-compose.prod.yml:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[hook] Bash called\" 1>&2"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}
