# ==========================================
# EmulFast — Environment Variables Template
# ==========================================
# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit .env เข้า git

# ---- General ----
NODE_ENV=development
TZ=Asia/Bangkok

# ---- External AI helpers (CLI) ----
# ใช้สำหรับ scripts/deepseek-research.sh และ scripts/gpt-debug.sh
DEEPSEEK_API_KEY=XXXXX
OPENAI_API_KEY=XXXXX
# Optional endpoint/model overrides
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- apps/api (NestJS) ----
API_PORT=4000
DATABASE_URL=postgresql://emulfast:postgres@localhost:5432/emulfast
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-random-32+chars
JWT_REFRESH_SECRET=change-me-to-different-random-32+chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Payment gateways (sandbox/test keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx
OMISE_WEBHOOK_SECRET=change-me

# Orchestrator (internal)
ORCHESTRATOR_URL=http://localhost:5000
ORCHESTRATOR_TOKEN=internal-token-change-me

# ---- apps/web (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SCRCPY_WS_URL=ws://localhost:8000

# ---- apps/orchestrator ----
ORCHESTRATOR_PORT=5000
DOCKER_HOST=unix:///var/run/docker.sock
# GID ของ docker group บน host — หาได้ด้วย: getent group docker | cut -d: -f3
# Linux/GCP: มักเป็น 999 หรือ 998 | WSL2 Docker Engine: ตรวจสอบด้วยคำสั่งข้างต้น
DOCKER_GID=999
REDROID_NETWORK=emulfast-redroid
ADB_PORT_RANGE_START=5555
ADB_PORT_RANGE_END=5655
WS_SCRCPY_BASE_URL=http://ws-scrcpy:8000

# Redroid images (override ได้ตาม Android version ที่ต้องการ)
REDROID_IMAGE_ANDROID_10=redroid/redroid:10.0.0_64only-latest
REDROID_IMAGE_ANDROID_12=redroid/redroid:12.0.0_64only-latest

# ---- Postgres (compose) ----
POSTGRES_DB=emulfast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Storage (Phase 6 — support image upload) ----
# ใช้ local volume สำหรับ Demo, หรือ S3-compatible เช่น MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./infra/docker/data/uploads
# หรือ
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://...
# S3_BUCKET=emulfast-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=